    <string name="help_title">Instructions &amp; Documents</string>
    <string name="help_intro_title">💡 Introduction</string>
    <string name="help_intro_content">This app is a real-time emotion detection tool based on deep learning. It uses MediaPipe for high-precision facial landmarking and combines it with ONNX neural network models to analyze subtle facial changes in real time, identifying the current psychological state.</string>
    <string name="help_algo_title">Core Algorithms</string>
    <string name="help_algo_fer_title">FER+ Model</string>
    <string name="help_algo_fer_content">A classic 64x64 input model that balances speed and accuracy, suitable for most everyday scenarios.</string>
    <string name="help_algo_hse_title">HSEmotion Model</string>
    <string name="help_algo_hse_content">A modern 224x224 E-Net architecture model that has better robustness against complex lighting and facial occlusions.</string>
    <string name="help_algo_mp_title">MediaPipe Blendshapes</string>
    <string name="help_algo_mp_content">When AI models are not yet loaded, the system performs geometric rule calculations based on 52 sets of facial coefficients to ensure real-time performance.</string>
    <string name="help_options_title">Options</string>
    <string name="help_option_fill_title">Fill Screen (Fill)</string>
    <string name="help_option_fill_content">The image will fill the entire screen; parts of the image may be cropped. Suitable for immersive display.</string>
    <string name="help_option_fit_title">Show All (Fit)</string>
    <string name="help_option_fit_content">Displays all content captured by the camera; black bars may appear on the screen edges.</string>
    <string name="help_privacy_title">🔒 Privacy &amp; Security</string>
    <string name="help_privacy_content">All image processing is done locally on the phone.\nNo data is uploaded to any server.</string>
    <string name="help_privacy_online">View Online Privacy Policy</string>
